<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#1E1E1E"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="#333333">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtProfileName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👤 İsim Soyisim"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2196F3"/>

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● BAĞLI"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:background="#1B5E20"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtRescueStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DURUM: BEKLEMEDE"
            android:textStyle="bold"
            android:textSize="13sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="#332E1A00"
            android:textColor="#FF9800"
            android:layout_marginTop="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/txtBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔋 Pil: %85"
                android:textColor="#AAAAAA"
                android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtBloodType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🩸 Kan Grubu: --"
                android:textColor="#FF5252"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/txtChronic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏥 Kronik Hastalık: --"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:layout_marginBottom="2dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/txtMeds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💊 Düzenli İlaç: --"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:layout_marginBottom="2dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/txtBirthDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Doğum Tarihi: --"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:layout_marginBottom="2dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/txtBuildingInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏢 Bina/Kat: --"
                android:textColor="#BBBBBB"
                android:textSize="13sp"
                android:layout_marginBottom="4dp"
                android:visibility="gone"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#121212"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/txtLastMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="🆘 Son Mesaj: İYİYİM"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="italic"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txtLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="📍 Konum: 39.123, 32.456"
            android:textSize="12sp"
            android:textColor="#888888" />

        <TextView
            android:id="@+id/txtTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🕒 Son Görülme: 14:30"
            android:textSize="11sp"
            android:textAlignment="viewEnd"
            android:textColor="#666666"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
