<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtProfileName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👤 İsim Soyisim"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1976D2"/>

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● BAĞLI"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtRescueStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DURUM: BEKLEMEDE"
            android:textStyle="bold"
            android:textSize="14sp"
            android:padding="4dp"
            android:background="#FFF3E0"
            android:textColor="#E65100"
            android:layout_marginTop="4dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔋 Pil: %85"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:id="@+id/layoutDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/txtBloodType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🩸 Kan Grubu: --"
                android:textColor="#C62828"
                android:textStyle="bold"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/txtChronic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏥 Kronik Hastalık: --"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/txtMeds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💊 Düzenli İlaç: --"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/txtBirthDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Doğum Tarihi: --"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/txtBuildingInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏢 Bina/Kat: --"
                android:textColor="#455A64"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtLastMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🆘 Son Mesaj: İYİYİM"
            android:textStyle="italic"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/txtLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Konum: 39.123, 32.456"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕒 Son Görülme: 14:30"
            android:textSize="11sp"
            android:textAlignment="viewEnd"
            android:textColor="#9E9E9E"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
